<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>.NET 8/10 command line app/dotnet tool to run XQuery 3.1 with Saxon 10.9 HE under .NET 8 or .NET 10</Title>
    <Version>10.9.20-pre1</Version>
    <Authors>Martin Honnen</Authors>
    <Copyright>Copyright (c) 2025 Martin Honnen</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>XQuery;XQuery-3.1;XML;JSON;XPath;XPath-3.1</PackageTags>
    <PackageReleaseNotes>This is the initial release of a package for .NET 8 and .NET 10 with the new IKVM 8.15.0/Maven 1.10.0 using the latest build u472-b08 of the Java 8/1.8 JDK</PackageReleaseNotes>
    <PackAsTool>True</PackAsTool>
    <ToolCommandName>SaxonHE10NetXQuery</ToolCommandName>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
	  <PackageProjectUrl>https://github.com/martin-honnen/SaxonHE10Net31/tree/master/SaxonHE10Net31XQuery</PackageProjectUrl>
	  <RepositoryUrl>https://github.com/martin-honnen/SaxonHE10Net31/tree/master/SaxonHE10Net31XQuery</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SaxonHE10Net31Api\SaxonHE10Net31Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
